{
  "name": "@zampayroll/web",
  "version": "0.1.0",
  "private": true,
  "description": "ZamPayroll React frontend",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc --build && vite build",
