# Local development only. Replace every password before using another environment.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_PROXY_TARGET=http://127.0.0.1:3000
WEB_PORT=8080
WEB_ORIGIN=http://127.0.0.1:5173
COMPOSE_WEB_ORIGIN=http://127.0.0.1:8080
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

POSTGRES_DB=zampayroll
POSTGRES_USER=zampayroll_admin
POSTGRES_PASSWORD=local_admin_only_change_me
POSTGRES_PORT=5432
MIGRATION_DB_PASSWORD=local_migrator_only_change_me
APP_DB_PASSWORD=local_app_only_change_me

# URL-encode passwords if they contain URL-reserved characters.
DATABASE_MIGRATION_URL=postgresql://zampayroll_migrator:local_migrator_only_change_me@127.0.0.1:5432/zampayroll
DATABASE_URL=postgresql://zampayroll_app:local_app_only_change_me@127.0.0.1:5432/zampayroll
TEST_DATABASE_MIGRATION_URL=postgresql://zampayroll_migrator:local_migrator_only_change_me@127.0.0.1:5432/zampayroll
TEST_DATABASE_URL=postgresql://zampayroll_app:local_app_only_change_me@127.0.0.1:5432/zampayroll
COMPOSE_DATABASE_MIGRATION_URL=postgresql://zampayroll_migrator:local_migrator_only_change_me@postgres:5432/zampayroll
COMPOSE_DATABASE_URL=postgresql://zampayroll_app:local_app_only_change_me@postgres:5432/zampayroll
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
