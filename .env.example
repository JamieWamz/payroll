# Local PostgreSQL development only. Do not use this file as an OCI/Neon staging
# or production environment file. Copy it to .env (which is ignored by Git),
# then replace every *_PASSWORD placeholder before using the database.
# Deployment identity: use development locally; staging/production require
# NODE_ENV=production, HTTPS WEB_ORIGIN and secure session cookies.
DEPLOYMENT_ENV=development
NODE_ENV=development
# Pino level. Never use trace/debug for production payroll traffic.
LOG_LEVEL=info
# Host interface and port for a host-run API. Docker sets HOST internally.
HOST=127.0.0.1
PORT=3000
# Host port published by the API Docker service; not the API's internal port.
API_PORT=3000
# Development-only Vite proxy target. It is not embedded in a production build.
API_PROXY_TARGET=http://127.0.0.1:3000
# Host port published by the web Docker service.
WEB_PORT=8080
# Exact browser origin allowed by API CORS. Production must be HTTPS.
WEB_ORIGIN=http://127.0.0.1:5173
# Browser origin used when the web Docker service proxies /api locally.
COMPOSE_WEB_ORIGIN=http://127.0.0.1:8080
# Enable only behind an Nginx proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Must be true in staging and production.
SESSION_COOKIE_SECURE=false
# Session lifetimes in seconds.
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# The remaining POSTGRES_* and COMPOSE_* values are for the local Compose
# PostgreSQL stack only; they are not Neon staging/production settings.
POSTGRES_DB=zampayroll
POSTGRES_USER=zampayroll_admin
POSTGRES_PASSWORD=local_admin_only_change_me
POSTGRES_PORT=5432
MIGRATION_DB_PASSWORD=local_migrator_only_change_me
APP_DB_PASSWORD=local_app_only_change_me

# PostgreSQL connection URLs for host development and tests. URL-encode any
# reserved password characters. Staging/production must use separately managed
# secret files or a secrets manager, never this sample.
DATABASE_MIGRATION_URL=postgresql://zampayroll_migrator:local_migrator_only_change_me@127.0.0.1:5432/zampayroll
DATABASE_URL=postgresql://zampayroll_app:local_app_only_change_me@127.0.0.1:5432/zampayroll
TEST_DATABASE_MIGRATION_URL=postgresql://zampayroll_migrator:local_migrator_only_change_me@127.0.0.1:5432/zampayroll
TEST_DATABASE_URL=postgresql://zampayroll_app:local_app_only_change_me@127.0.0.1:5432/zampayroll
COMPOSE_DATABASE_MIGRATION_URL=postgresql://zampayroll_migrator:local_migrator_only_change_me@postgres:5432/zampayroll
COMPOSE_DATABASE_URL=postgresql://zampayroll_app:local_app_only_change_me@postgres:5432/zampayroll
# PostgreSQL pool/TLS settings.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
