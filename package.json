{
  "name": "zampayroll",
  "version": "0.1.0",
  "private": true,
  "description": "Zambia-specific payroll SaaS for SMEs and accounting firms",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:down": "docker compose --env-file .env -f compose.yaml -f compose.dev.yaml down",
    "db:migrate": "npm run db:migrate --workspace @zampayroll/api",
    "db:migrate:create": "npm run db:migrate:create --workspace @zampayroll/api --",
    "db:migrate:down": "npm run db:migrate:down --workspace @zampayroll/api",
    "db:up": "docker compose --env-file .env -f compose.yaml -f compose.dev.yaml up -d postgres",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev --workspace @zampayroll/api\" \"npm run dev --workspace @zampayroll/web\"",
    "dev:api": "npm run dev --workspace @zampayroll/api",
    "dev:web": "npm run dev --workspace @zampayroll/web",
    "docker:config": "docker compose --env-file .env config --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
